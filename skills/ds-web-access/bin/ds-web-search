#!/usr/bin/env bash
# ds-web-search — location-independent launcher for the DeepSeek Search API.
set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if command -v cygpath >/dev/null 2>&1; then
  PROJECT_DIR="$(cygpath -w "$PROJECT_DIR")"
fi
exec uv run --project "$PROJECT_DIR" ds-web-search "$@"
