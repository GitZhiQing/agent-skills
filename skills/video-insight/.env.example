# video-insight 环境配置（复制为 .env 并填写；.env 已 gitignore，不会入库）
# 读取顺序：环境变量 > 本文件（doctor.py / transcribe.py / screen_ocr.py 一致）

# ---- 转写（口播视频 L1 需要；无口播分支 / 已有转写稿 / L2 画面档不需要）----
# 火山引擎豆包录音文件识别大模型 API Key
# 获取：控制台 > 语音技术 > API Key 管理
# https://console.volcengine.com/speech/new/setting/apikeys
VOLC_BIGMODEL_API_KEY=your_volcengine_api_key
# 以下两项通常保持默认即可
VOLC_BIGMODEL_RESOURCE_ID=volc.seedasr.auc
VOLC_BIGMODEL_API_BASE=https://openspeech.bytedance.com

# ---- OCR 回退（可选：仅无读图能力的 agent 对无口播视频提取画面文案时用）----
# 星河社区访问令牌页免费获取：https://aistudio.baidu.com/token
# PADDLEOCR_ACCESS_TOKEN=your_aistudio_token
