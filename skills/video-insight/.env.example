# video-insight 环境配置（复制为 .env 并填写）
# 转写能力来自上游技能 video-to-subtitle-summary，其 .env 中的 Key 会被自动发现；
# 仅当上游未配置时才需要在这里再配一份。

# 火山引擎豆包录音文件识别大模型（API Key 来源：控制台 > API Key 管理
# https://console.volcengine.com/speech/new/setting/apikeys）
VOLC_BIGMODEL_API_KEY=your_volcengine_api_key
VOLC_BIGMODEL_RESOURCE_ID=volc.seedasr.auc
VOLC_BIGMODEL_API_BASE=https://openspeech.bytedance.com

# 可选：显式指定上游 ASR 脚本路径。
# 默认自动发现同一 skills 根目录下的
# video-to-subtitle-summary/scripts/transcribe_volcengine_bigmodel.py
# VIDEO_INSIGHT_ASR_SCRIPT=
